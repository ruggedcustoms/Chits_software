{
  "name": "chit-master-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply chit-master-dev --local",
    "db:seed:local": "wrangler d1 execute chit-master-dev --local --file seed/dev.sql",
    "db:migrate:remote": "wrangler d1 migrations apply chit-master-dev --remote",
    "db:seed:remote": "wrangler d1 execute chit-master-dev --remote --file seed/dev.sql"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
